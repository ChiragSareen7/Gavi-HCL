# Backend env (copy to backend/.env)

# Groq OpenAI-compatible base URL (example format)
GROQ_BASE_URL="https://<your-groq-openai-base>/openai/v1"

# API key (do not commit)
GROQ_API_KEY="YOUR_KEY_HERE"

# Models to compare
BASE_MODEL="meta-llama/Meta-Llama-3-8B-Instruct"
FT_MODEL="YOUR_FINE_TUNED_MODEL_NAME"


